if quit<>1 then pln
if quit<>1 then pln Исключительно для свечного анализа :
if quit<>1 then pln Максимальная цена : #(максимальная_цена/100)$
if quit<>1 then pln Минимальная цена : #(минимальная_цена/100)$
if quit<>1 then pln Цена открытия : #(цена_открытие/100)$
if quit<>1 then pln Цена закрытия : #(цена_закрытие/100)$
if quit<>1 then btn биржа_покупка, Купить рис
if quit<>1 then btn биржа_продажа, Продать рис
if quit<>1 then btn биржа_считать_курс,Дальше
end


:новость_часа
число=10
proc rnd
if рнд=1 then instr местность=Синдзюку
if рнд=2 then instr местность=Йокоги
if рнд=3 then instr местность=Хокарадо
if рнд=4 then instr местность=Микасадзе
if рнд=5 then instr местность=Хорюдзе
if рнд=6 then instr местность=Санодзюро
if рнд=7 then instr местность=Сипароя
if рнд=8 then instr местность=Ондэ
if рнд=9 then instr местность=Кайо
if рнд=10 then instr местность=Михаго
число=10
proc rnd
р=рнд
if р=1 then instr новость#час$=Пожар в амбарах #%местность$! &число=10&proc rnd&сила_медведей=сила_медведей+рнд
if р=2 then instr новость#час$=Крысы сьели весь рис в закромах #%местность$&число=3&proc rnd&сила_медведей=сила_медведей+рнд
if р=3 then instr новость#час$=Снег в #%местность$ погубил урожай риса&число=6&proc rnd&сила_медведей=сила_медведей+рнд
if р=4 then instr новость#час$=Разбойники в #%местность$ перебили всех крестьян и забрали рис.&число=8&proc rnd&сила_медведей=сила_медведей+рнд
if р=5 then instr новость#час$=Все спокойно в #%местность$
if р=6 then instr новость#час$=Из #%местность$ нет никаких новостей
if р=7 then instr новость#час$=Долгожданный дождь пошел в #%местность$&число=8&proc rnd&сила_быков=сила_быков+рнд
if р=8 then instr новость#час$=Буддистские монахи обещают хороший урожай риса в #%местность$&число=6&proc rnd&сила_быков=сила_быков+рнд
if р=9 then instr новость#час$=По слухам в #%местность$ будет хороший урожай риса в этом году.&число=3&proc rnd&сила_быков=сила_быков+рнд
if р=10 then instr новость#час$=Карательные акции самураев позволили добыть больше риса в #%местность$&число=10&proc rnd&сила_быков=сила_быков+рнд
if р<=4 then фунд=фунд+1
if р>=7 then фунд=фунд-1
end

:биржа_считать_курс
час=час+1
proc новость_часа
if час=1 then proc биржа_начало_дня
цена_открытие=курс_покупка
максимальная_цена=0
минимальная_цена=999999
proc биржа_считать_курс_локальный
proc биржа_считать_курс_локальный
proc биржа_считать_курс_локальный
proc биржа_считать_курс_локальный
proc биржа_считать_курс_локальный
proc биржа_считать_курс_локальный
цена_закрытие=курс_покупка
if час=6 then proc биржа_конец_дня
if quit<>1 then if час=1 then if деньги_джиро>=(курс_продажа/100) then деньги_джиро=деньги_джиро-(курс_продажа/100)&рис_джиро=рис_джиро+1
if quit<>1 then if час=5 then if рис_джиро>0 then деньги_джиро=деньги_джиро+(курс_покупка/100)&рис_джиро=рис_джиро-1
if quit<>1 then if цена_закрытие>цена_открытие then if деньги_таро>=(курс_продажа/100) then деньги_таро=деньги_таро-(курс_продажа/100)&рис_таро=рис_таро+1
if quit<>1 then if цена_закрытие<цена_открытие then if рис_таро>0 then деньги_таро=деньги_таро+(курс_покупка/100)&рис_таро=рис_таро-1
goto биржа_курс
end

:биржа_считать_курс_локальный
if минимальная_цена>курс_покупка then минимальная_цена=курс_покупка
if максимальная_цена<курс_покупка then максимальная_цена=курс_покупка
число=21
proc rnd
предыдущий_курс=курс_покупка
курс_покупка=курс_покупка-10+рнд-сила_быков+сила_медведей
курс_продажа=курс_покупка+1
;if курс_продажа>5000 then курс_продажа=курс_продажа+1
курс_продажа=курс_покупка*1.002
if предыдущий_курс<курс_покупка then сила_быков=сила_быков+1
if предыдущий_курс>курс_покупка then сила_медведей=сила_медведей+1
if курс_покупка<600 then сила_медведей=сила_медведей+5
if курс_покупка>7400 then сила_быков=сила_быков+5
if минимальная_цена>курс_покупка then минимальная_цена=курс_покупка
if максимальная_цена<курс_покупка then максимальная_цена=курс_покупка
end

:биржа_начало_дня
instr новость1=
instr новость2=
instr новость3=
instr новость4=
instr новость5=
instr новость6=
день=день+1
if день>=31 then goto миссия_1_конец
pln Биржа закрылась, и отправившись на постоялый двор, вы, устав от бесконечных торгов упали на циновку и уснули, предварительно поев.
pln
pln За еду и постель с вас 0.50 йен
inv- 0.50,йен
деньги_таро=деньги_таро-0.5
деньги_джиро=деньги_джиро-0.5
деньги_таро=деньги_таро-рис_таро*0.1
деньги_джиро=деньги_джиро-рис_джиро*0.1
pln
pln За хранение риса с вас налог #(inv_коку риса/10)$ йен.
pln
inv- #(inv_коку риса/10)$,йен
if not йен then goto биржа_нет_денег
pln
pln Начало торгов на бирже
pln
число=10
proc rnd
сила_быков=сила_быков+рнд
число=10
proc rnd
сила_медведей=сила_медведей+рнд
end

:биржа_конец_дня
час=0
pln Конец дня на бирже!!!
pln
pln Конечные цены установлены :
end

:биржа_нет_денег
pln У вас нет денег, чтобы заплатить за ночлег! Стражи порядка спешно арестовывают вас, и отправляют на полезные хозяйственный работы по посеву риса, чтобы отработать вашу провинность.
число=3
proc rnd
рнд=рнд+1
день=день+рнд
pln Проведя #рнд$ дня на посевах риса, вы возвращаетесь на торги.
end

